# -----------------------------------------------------------------------------
#                       MAKEFILE
#
PROJ = haScreensav              # C++ module
FOLDER = C:\Temp600\__\         # Folder prefix to the project,
                                #  using 2019 MS Build-tools.

##ha''# -----------------------------------------------------------------------------
##ha''#                       GLOBAL TOOL OPTIONS
##ha''#
##ha''RFLAGS=
##ha''
##ha''AFLAGS=/nologo /c /Sn /Sg /Sp84 /Fl
##ha''
##ha''! IF ($(FLAG) == "64bit Version")       # For Win10
##ha''CFLAGS=/c /nologo /Od /Dx64 /EHsc
##ha''! ELSE                                  # For Windows XP and Win10
##ha''CFLAGS=/c /nologo /Od /EHsc
##ha''! ENDIF
##ha''
##ha''## To tell Microsoft's linker which entry point to use,
##ha''## namely "LFLAGS=/ENTRY:mainCRTStartup", which calls standard main.
##ha''
##ha''LFLAGS=/nologo /INCREMENTAL /SUBSYSTEM:windows
##ha''
##ha''LIBS= KERNEL32.LIB USER32.LIB GDI32.LIB WINSPOOL.LIB COMDLG32.LIB ADVAPI32.LIB \
##ha''      SHELL32.LIB OLE32.LIB OLEAUT32.LIB UUID.LIB ODBC32.LIB ODBCCP32.LIB \
##ha''      Comctl32.lib shlwapi.lib uxtheme.lib Propsys.lib scrnsave.lib
##ha''
##ha''# -----------------------------------------------------------------------------
##ha''#       MACRO DEFINITIONS OF THE PROJEC OBJECT MODULE DEPEDENCIES
##ha''#
##ha''OBJECTS = $(FOLDER)$(PROJ).obj $(FOLDER)haScrFaust.obj $(FOLDER)haScrTxTFile.obj \
##ha''          $(FOLDER)haScrDraw.obj $(FOLDER)haScrBrowse.obj $(FOLDER)haScrMenu.obj \
##ha''          $(FOLDER)haScrRenumber.obj $(FOLDER)$(PROJ).res
##ha''
##ha''CLEAN =  $(FOLDER)*.ilk

#------------------------------------------------------------------------------
#                           INFERENCE RULE
#
.rc.res:
        @RC $(RFLAGS) $(FOLDER)$(@B).rc

.asm.obj:
##        @ML $(AFLAGS) /Fo$(FOLDER)$(@B).obj /Fl$(FOLDER)$(@B).lst $(FOLDER)$(@B).asm
        $(AS) $(AFLAGS) /Fo$(FOLDER)$(@B).obj /Fl$(FOLDER)$(@B).lst $(FOLDER)$(@B).asm

.c.obj:
        @CL $(CFLAGS) /Fo$(FOLDER)$(@B).obj $(FOLDER)$(@B).c

.cpp.obj:
        @CL $(CFLAGS) /Fo$(FOLDER)$(@B).obj $(FOLDER)$(@B).cpp

#------------------------------------------------------------------------------
#       PSEUDO TARGET POINTING TO THE REAL TARGET
#
_all:   $(FOLDER)$(PROJ).exe

#
# Set a flag in an NMAKE Makefile if the cl compiler version is 16.
# Note that cl /? prints the version information to the standard error stream
#  and the help text to the standard output.
#  To be able to check the version with the findstr command one must first
#  redirect stderr to stdout using 2>&1.
# 
# -------------------------------------------------
# Determine the assembler/compiler version in use: |
#  Microsoft Visual Studio 2019 (Windows 10 64bit) |
#   ML64 Version 14.28.29336.0 for x64             |
#   CL Version 19.28.29336 for x64                 |
#  Microsoft Visual Studio 2019 (Windows 10 32bit) |
#   ML Version 14.28.29910.0 for x86               |
#   CL Version 19.28.29910 for x86                     |
#  Microsoft Visual Studio 2010 (WindowsXP 32bit)  |
#   ML Version 14.28.29910.0 for x86 (=VS 2019)    |
#   CL Version 16.00.30319.01 for 80x86            |
# -------------------------------------------------
!IF ([ml64 2>&1 | findstr /C:"x64" > nul] == 0) 
FLAG = "64bit Version"         # 64bit for Windows 10, ..
!ELSEIF ([cl 2>&1 | findstr /C:"Version 16" > nul] == 0)
FLAG = "32bit XP Version"      # 32bit for XP and Win10, ..
OS = "_XP"
!ELSE 
FLAG = "32bit Version"         # 32bit for Windows 10, ..
OS = "W10"
!ENDIF
# Nice trick to display the current Version $(FLAG)
# Since Nmake does not recognize any console commands
# at this point within the script.
!IF ([ECHO 2>&1 ---BUILD---$(FLAG)])
!ENDIF
!IF ([ECHO. 2>&1])
!ENDIF

# -----------------------------------------------------------------------------
#                       GLOBAL TOOL OPTIONS
#
RFLAGS=

AFLAGS=/nologo /c /Sn /Sg /Sp84 /Fl

! IF ($(FLAG) == "64bit Version")       # For Win10
CFLAGS=/c /nologo /Od /Dx64 /EHsc
! ELSE                                  # For Windows XP and Win10
CFLAGS=/c /nologo /Od /EHsc
! ENDIF

## To tell Microsoft's linker which entry point to use,
## namely "LFLAGS=/ENTRY:mainCRTStartup", which calls standard main.

LFLAGS=/nologo /INCREMENTAL /SUBSYSTEM:windows

LIBS= KERNEL32.LIB USER32.LIB GDI32.LIB WINSPOOL.LIB COMDLG32.LIB ADVAPI32.LIB \
      SHELL32.LIB OLE32.LIB OLEAUT32.LIB UUID.LIB ODBC32.LIB ODBCCP32.LIB \
      Comctl32.lib shlwapi.lib uxtheme.lib Propsys.lib scrnsave.lib

# -----------------------------------------------------------------------------
#       MACRO DEFINITIONS OF THE PROJEC OBJECT MODULE DEPEDENCIES
#
OBJECTS = $(FOLDER)$(PROJ).obj $(FOLDER)haScrFaust.obj $(FOLDER)haScrTxTFile.obj \
          $(FOLDER)haScrDraw.obj $(FOLDER)haScrBrowse.obj $(FOLDER)haScrMenu.obj \
          $(FOLDER)haScrRenumber.obj $(FOLDER)$(PROJ).res

CLEAN =  $(FOLDER)*.ilk

# -----------------------------------------------------------------------------
#        $(PROJ).EXE: LIST OF DEPENDENCIES FOR EVERY OBJECT FILE
#
$(FOLDER)$(PROJ).res:       $(FOLDER)$(@B).rc $(FOLDER)$(PROJ).h $(FOLDER)*.ico

$(FOLDER)$(PROJ).obj:       $(FOLDER)$(@B).cpp $(FOLDER)$(PROJ).h $(FOLDER)$(PROJ).rc

$(FOLDER)haScrFaust.obj:    $(FOLDER)$(@B).cpp $(FOLDER)$(PROJ).h $(FOLDER)$(PROJ).rc

$(FOLDER)haScrTxtFile.obj:  $(FOLDER)$(@B).cpp $(FOLDER)$(PROJ).h $(FOLDER)$(PROJ).rc

$(FOLDER)haScrDraw.obj:     $(FOLDER)$(@B).cpp $(FOLDER)$(PROJ).h $(FOLDER)$(PROJ).rc

$(FOLDER)haScrBrowse.obj:   $(FOLDER)$(@B).cpp $(FOLDER)$(PROJ).h $(FOLDER)$(PROJ).rc

$(FOLDER)haScrMenu.obj:     $(FOLDER)$(@B).cpp $(FOLDER)$(PROJ).h $(FOLDER)$(PROJ).rc

$(FOLDER)haScrRenumber.obj: $(FOLDER)$(@B).cpp $(FOLDER)$(PROJ).h $(FOLDER)$(PROJ).rc

#------------------------------------------------------------------------------
#       $(PROJ).EXE TARGET BUILD
#
$(FOLDER)$(PROJ).exe:   $(OBJECTS)
#
# Detect if "$(PROJ).exe" is running. It must be terminated before rebuild.
# ":" should appear in TASKLIST output only if the task is NOT found,
# Hence FIND will set the ERRORLEVEL to 0 for 'not found' and 1 for 'found'.
#
!IF ([tasklist /NH /FI "IMAGENAME eq $(PROJ).exe" | FIND ":" > nul] == 1)
        -TASKKILL /F /IM $(@F) > nul
!ENDIF
        LINK $(LFLAGS)  /OUT:$(FOLDER)$(@F) $** $(LIBS) >$(FOLDER)$(@B).link
        DEL $(CLEAN)
        @ECHO.
        @COPY $(FOLDER)$(@F) $(FOLDER)$(@B).scr >nul
!IF ($(FLAG) == "64bit Version")            # For Win10, ..
        @COPY $(FOLDER)$(@F) $(FOLDER)$(@B)64.exe >nul 
        @ECHO Build Complete (64bit): $(@F)
        @COPY $(FOLDER)$(@F) $(FOLDER)$(@B)64.scr >nul
        @ECHO Build Complete (64bit): $(@B)64.scr
!ELSEIF	($(FLAG) == "32bit XP Version")     # 32bit for XP and Win10, ..
        @COPY $(FOLDER)$(@F) $(FOLDER)$(@B)_XP.exe >nul 
        @ECHO Build Complete (XP): $(@F)
        @COPY $(FOLDER)$(@F) $(FOLDER)$(@B)_XP.scr >nul
        @ECHO Build Complete (XP): $(@B)_XP.scr
!ELSE				            # 32bit for Win10, ..
        @COPY $(FOLDER)$(@F) $(FOLDER)$(@B)32.exe >nul 
        @ECHO Build Complete (32bit): $(@F)
        @COPY $(FOLDER)$(@F) $(FOLDER)$(@B)32.scr >nul
        @ECHO Build Complete (32bit): $(@B)32.scr
!ENDIF

# -----------------------------  END OF MAKEFILE 32 BIT ----------------------------
